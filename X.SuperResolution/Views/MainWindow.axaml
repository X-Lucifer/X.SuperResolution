<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:X.SuperResolution.ViewModels"
        xmlns:controls="using:X.SuperResolution.Controls"
        x:Class="X.SuperResolution.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/logo.ico"
        Title="{DynamicResource MainTitle}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="True"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="48,1,*,31">
        <!-- Custom Fluent title bar: product controls left, utility/window controls right. -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,*"
                      Background="Transparent"
                      PointerPressed="TitleBar_OnPointerPressed">
                    <Grid Width="48" Height="48">
                        <Border Width="29" Height="29"
                                CornerRadius="5"
                                Background="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="X²"
                                       FontFamily="{DynamicResource DataFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="X.SuperResolution"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Border Width="1"
                                Height="14"
                                Background="{DynamicResource BorderStrongBrush}" />
                        <TextBlock Text="{DynamicResource ProductTagline}"
                                   Classes="Muted"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Width="112"
                              MinHeight="32"
                              Margin="0,8,6,8"
                              Padding="9,4"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemsSource="{Binding LangList}"
                              SelectedValue="{Binding CurrentLang}"
                              DisplayMemberBinding="{Binding Value}"
                              SelectedValueBinding="{Binding Key}"
                              SelectionChanged="Lang_OnSelectionChanged"
                              x:CompileBindings="False" />

                    <HyperlinkButton Classes="TitleLink"
                                     NavigateUri="https://github.com/X-Lucifer"
                                     Margin="0,8,6,8"
                                     Content="GitHub" />

                    <Button Classes="WindowAction"
                            ToolTip.Tip="{DynamicResource Minimize}"
                            Click="MinimizeButton_OnClick">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2,8 L 14,8"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.4" />
                        </Canvas>
                    </Button>
                    <Button Classes="WindowAction"
                            ToolTip.Tip="{DynamicResource Maximize}"
                            Click="MaximizeButton_OnClick">
                        <Grid Width="16" Height="16">
                            <Canvas x:Name="MaximizeIcon" Width="16" Height="16">
                                <Rectangle Canvas.Left="2"
                                           Canvas.Top="2"
                                           Width="12"
                                           Height="12"
                                           Fill="Transparent"
                                           Stroke="{DynamicResource TextPrimaryBrush}"
                                           StrokeThickness="1.2" />
                            </Canvas>
                            <Canvas x:Name="RestoreIcon"
                                    Width="16"
                                    Height="16"
                                    IsVisible="False">
                                <Rectangle Canvas.Left="4"
                                           Canvas.Top="2"
                                           Width="10"
                                           Height="10"
                                           Fill="{DynamicResource TitleBarBrush}"
                                           Stroke="{DynamicResource TextPrimaryBrush}"
                                           StrokeThickness="1.2" />
                                <Rectangle Canvas.Left="2"
                                           Canvas.Top="4"
                                           Width="10"
                                           Height="10"
                                           Fill="{DynamicResource TitleBarBrush}"
                                           Stroke="{DynamicResource TextPrimaryBrush}"
                                           StrokeThickness="1.2" />
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button Classes="WindowAction WindowClose"
                            ToolTip.Tip="{DynamicResource Exit}"
                            Click="CloseButton_OnClick">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.4" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Precision rail: blue for configuration, cyan for processing feedback. -->
        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}">
            <Border Width="240"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource PrimaryBrush}" />
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="360,*,340"
              ColumnSpacing="12"
              Margin="16,14,16,12">
            <controls:ProcessingSettingsPanel Grid.Column="0" />
            <controls:TaskWorkspace Grid.Column="1" />
            <controls:ActivityPanel Grid.Column="2" />
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*" Margin="16,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <Border Width="6"
                            Height="6"
                            CornerRadius="3"
                            Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource PipelineReady}"
                               Classes="Muted"
                               FontSize="9" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Copyright © Lucifer · X SuperResolution"
                           Classes="Tertiary"
                           FontSize="9"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text=".NET 10 · AVALONIA · VULKAN"
                           Classes="Data Tertiary"
                           FontSize="8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
