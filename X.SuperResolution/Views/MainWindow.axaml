<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:X.SuperResolution.ViewModels"
        xmlns:controls="using:X.SuperResolution.Controls"
        x:Class="X.SuperResolution.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/logo.ico"
        Title="{DynamicResource MainTitle}"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="True"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid x:Name="WindowSurface" RowDefinitions="54,*,36"
          Background="{DynamicResource AppBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,*"
                      Background="Transparent"
                      PointerPressed="TitleBar_OnPointerPressed">
                    <Grid Width="54" Height="54">
                        <Border Width="34" Height="34"
                                CornerRadius="8"
                                Background="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="X²"
                                       FontFamily="{DynamicResource DataFontFamily}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryContentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="X.SuperResolution"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="/"
                                   Classes="Tertiary"
                                   FontSize="11" />
                        <TextBlock Text="{DynamicResource ProductTagline}"
                                   Classes="Muted"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="ThemeToggle"
                                  Classes="ThemeSwitch"
                                  AutomationProperties.AutomationId="ThemeToggle"
                                  AutomationProperties.Name="{DynamicResource ThemeToggleLabel}"
                                  ToolTip.Tip="{DynamicResource ThemeToggleLabel}"
                                  Click="ThemeToggle_OnClick" />

                    <ComboBox Classes="LanguagePicker"
                              Width="106"
                              MinHeight="34"
                              Margin="0,10,4,10"
                              Padding="9,4"
                              AutomationProperties.Name="{DynamicResource Language}"
                              ItemsSource="{Binding LangList}"
                              SelectedValue="{Binding CurrentLang}"
                              DisplayMemberBinding="{Binding Value}"
                              SelectedValueBinding="{Binding Key}"
                              SelectionChanged="Lang_OnSelectionChanged"
                              x:CompileBindings="False" />

                    <HyperlinkButton Classes="TitleLink"
                                     NavigateUri="https://github.com/X-Lucifer"
                                     Margin="0,10,4,10"
                                     Content="GitHub" />

                    <Button Classes="WindowAction"
                            ToolTip.Tip="{DynamicResource Minimize}"
                            AutomationProperties.Name="{DynamicResource Minimize}"
                            Click="MinimizeButton_OnClick">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 2,8 L 14,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" />
                        </Canvas>
                    </Button>
                    <Button Classes="WindowAction"
                            ToolTip.Tip="{DynamicResource Maximize}"
                            AutomationProperties.Name="{DynamicResource Maximize}"
                            Click="MaximizeButton_OnClick">
                        <Grid Width="16" Height="16">
                            <Canvas x:Name="MaximizeIcon" Width="16" Height="16">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="12"
                                           Fill="Transparent"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.2" />
                            </Canvas>
                            <Canvas x:Name="RestoreIcon" Width="16" Height="16" IsVisible="False">
                                <Rectangle Canvas.Left="4" Canvas.Top="2" Width="10" Height="10"
                                           Fill="{DynamicResource TitleBarBrush}"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.2" />
                                <Rectangle Canvas.Left="2" Canvas.Top="4" Width="10" Height="10"
                                           Fill="{DynamicResource TitleBarBrush}"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.2" />
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button Classes="WindowAction WindowClose"
                            ToolTip.Tip="{DynamicResource Exit}"
                            AutomationProperties.Name="{DynamicResource Exit}"
                            Click="CloseButton_OnClick">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              x:Name="WorkbenchEntrance"
              ColumnDefinitions="*,382"
              ColumnSpacing="16"
              Margin="20,18,20,16">
            <controls:TaskWorkspace Grid.Column="0" />

            <Border Grid.Column="1" Classes="Card" Padding="14">
                <TabControl Classes="InspectorTabs">
                    <TabItem Classes="InspectorTab"
                             Header="{DynamicResource EnhanceTab}"
                             AutomationProperties.Name="{DynamicResource EnhanceTab}">
                        <controls:ProcessingSettingsPanel Margin="0,14,0,0" />
                    </TabItem>
                    <TabItem Classes="InspectorTab"
                             Header="{DynamicResource ActivityTab}"
                             AutomationProperties.Name="{DynamicResource ActivityTab}">
                        <controls:ActivityPanel Margin="0,14,0,0" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource TitleBarBrush}">
            <TextBlock Text="{x:Static vm:MainWindowViewModel.Copyright}"
                       Classes="Tertiary"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
