<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:X.SuperResolution.Controls">
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>
    <!-- Theme changes interpolate the painted surfaces and text together. -->
    <Style Selector="Window">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid#WindowSurface">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock, Button, ComboBox, RadioButton.EngineSegment, TabItem.InspectorTab">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="TextElement.Foreground" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SelectionPill">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30" Easing="0.22,1,0.36,1" />
                <BrushTransition Property="Background" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Unclassified labels inherit their control's foreground, including disabled and selected states. -->
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Eyebrow">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LetterSpacing" Value="0.45" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Tertiary">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Data">
        <Setter Property="FontFamily" Value="{DynamicResource DataFontFamily}" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.InnerPanel">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.TaskItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.SettingsGroup">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.SettingRow">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.GroupDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="13,0" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ButtonSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="ButtonContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.PrimaryAction">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryContentBrush}" />
    </Style>
    <Style Selector="Button.PrimaryAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.PrimaryAction:pressed">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.PrimaryAction:disabled">
        <Setter Property="Background" Value="{DynamicResource PrimaryDisabledBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Button.PrimaryAction TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryContentBrush}" />
    </Style>
    <Style Selector="Button.PrimaryAction:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Button.SecondaryAction">
        <Setter Property="Background" Value="{DynamicResource FieldSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.SecondaryAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button.SecondaryAction:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
    </Style>
    <Style Selector="Button.DangerAction">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.DangerAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerPressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.DangerAction:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerPressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.DangerAction:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="Button.GhostAction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.GhostAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.GhostAction:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.GhostAction:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.IconAction">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.IconAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.IconAction:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ActionButton">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.HeaderAction">
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Button.WindowAction">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="54" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.WindowAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="Button.WindowAction:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
    </Style>
    <Style Selector="Button.WindowClose:pointerover">
        <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
    </Style>
    <Style Selector="Button.WindowClose:pressed">
        <Setter Property="Background" Value="{DynamicResource WindowClosePressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
    </Style>

    <Style Selector="HyperlinkButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="HyperlinkButton:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch">
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,12,8,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Width="58" Height="30">
                    <Border Name="ThemeSwitchTrack"
                            Background="{DynamicResource ThemeToggleTrackBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="15" />
                    <Border Name="ThemeSwitchThumb"
                            Width="24"
                            Height="24"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ThemeToggleThumbBrush}"
                            CornerRadius="12">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26"
                                                               Easing="0.22,1,0.36,1" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Grid Margin="7,0" ColumnDefinitions="*,*" IsHitTestVisible="False">
                        <Path Name="ThemeSunIcon"
                              Width="13"
                              Height="13"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Data="M9,0 H11 V3 H9 Z M9,17 H11 V20 H9 Z M0,9 H3 V11 H0 Z M17,9 H20 V11 H17 Z M2.2,2.2 L4.4,4.4 L3,5.8 L0.8,3.6 Z M15.6,15.6 L17.8,17.8 L16.4,19.2 L14.2,17 Z M17.8,2.2 L19.2,3.6 L17,5.8 L15.6,4.4 Z M2.2,17.8 L4.4,15.6 L5.8,17 L3.6,19.2 Z M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5 Z" />
                        <Path Grid.Column="1"
                              Name="ThemeMoonIcon"
                              Width="13"
                              Height="13"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Data="M8,2 C4.5,2.9 2,6.1 2,9.9 C2,14.4 5.6,18 10.1,18 C13.9,18 17.1,15.5 18,12 C16.9,13.3 15.2,14.1 13.4,14.1 C9.3,14.1 5.9,10.7 5.9,6.6 C5.9,4.9 6.7,3.2 8,2 Z" />
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch /template/ Path#ThemeSunIcon">
        <Setter Property="Fill" Value="{DynamicResource ThemeToggleActiveIconBrush}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch /template/ Path#ThemeMoonIcon">
        <Setter Property="Fill" Value="{DynamicResource ThemeToggleInactiveIconBrush}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:pointerover /template/ Border#ThemeSwitchTrack">
        <Setter Property="Background" Value="{DynamicResource ThemeToggleTrackHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:pressed /template/ Border#ThemeSwitchTrack">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:checked /template/ Path#ThemeSunIcon">
        <Setter Property="Fill" Value="{DynamicResource ThemeToggleInactiveIconBrush}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:checked /template/ Path#ThemeMoonIcon">
        <Setter Property="Fill" Value="{DynamicResource ThemeToggleActiveIconBrush}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:focus-visible /template/ Border#ThemeSwitchTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="RepeatButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RepeatButton:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="HyperlinkButton.TitleLink">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="HyperlinkButton.TitleLink:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="HyperlinkButton.TitleLink:pressed">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource FieldSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ComboFieldSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid ColumnDefinitions="*,24">
                            <ContentPresenter Name="SelectionPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              ClipToBounds="True"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Path Grid.Column="1"
                                      Name="DropDownGlyph"
                                      Width="9"
                                      Height="9"
                                      Margin="0,0,9,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.35"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Stretch="Uniform"
                                      Data="M 1,3 L 5,7 L 9,3" />
                        </Grid>
                    </Border>
                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           PlacementTarget="ComboFieldSurface"
                           Placement="Bottom"
                           VerticalOffset="5"
                           IsLightDismissEnabled="True"
                           WindowManagerAddShadowHint="False"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
                        <!-- Keep the rounded outline inside the popup; the Win32 shadow adds a rectangular bottom/right edge. -->
                        <Border Name="ComboPopupSurface"
                                Padding="4"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <ScrollViewer Name="ComboPopupContent"
                                          MaxHeight="300"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox:dropdownopen">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ComboBox.LanguagePicker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox.LanguagePicker:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.LanguagePicker:focus">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.LanguagePicker:focus-visible /template/ Path#DropDownGlyph">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.InlineField">
        <Setter Property="Width" Value="180" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MaxWidth" Value="180" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{DynamicResource FieldSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox.InlineField:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.InlineField:focus">
        <Setter Property="Background" Value="{DynamicResource FieldSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox.InlineField /template/ Path#DropDownGlyph">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter#SelectionPresenter TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="ComboItemContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ComboHoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pressed">
        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style
        Selector="ComboBoxItem /template/ ContentPresenter#ComboItemContent,
                     ComboBoxItem:pointerover /template/ ContentPresenter#ComboItemContent,
                     ComboBoxItem:pressed /template/ ContentPresenter#ComboItemContent,
                     ComboBoxItem:selected /template/ ContentPresenter#ComboItemContent,
                     ComboBoxItem:selected:pointerover /template/ ContentPresenter#ComboItemContent,
                     ComboBoxItem:selected:pressed /template/ ContentPresenter#ComboItemContent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PrimaryContentBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBox.LogViewer">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Top" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
        <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Width="38" Height="22">
                    <Border Name="CompactSwitchTrack"
                            CornerRadius="11"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1" />
                    <Canvas Name="PART_SwitchKnob" Width="38" Height="22">
                        <Grid Name="PART_MovingKnobs"
                              Width="0"
                              Height="0"
                              Opacity="0" />
                        <Grid Name="CompactSwitchVisualKnob"
                              Width="18"
                              Height="18"
                              Canvas.Left="2"
                              Canvas.Top="2">
                            <Ellipse Name="CompactSwitchKnob"
                                     Width="16"
                                     Height="16"
                                     Fill="{DynamicResource SurfaceBrush}" />
                        </Grid>
                    </Canvas>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch:pointerover /template/ Border#CompactSwitchTrack">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch:checked /template/ Border#CompactSwitchTrack">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch:focus-visible /template/ Border#CompactSwitchTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="RadioButton.EngineSegment">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.EngineSegment:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="RadioButton.EngineSegment:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.EngineSegment:checked">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="TabControl.InspectorTabs">
        <Setter Property="PageTransition">
            <CrossFade Duration="0:0:0.24" FadeInEasing="0.22,1,0.36,1" FadeOutEasing="0.4,0,0.6,1" />
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" Columns="2" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="4"
                            Margin="0,0,0,15"
                            CornerRadius="8"
                            Background="{DynamicResource ElevatedSurfaceBrush}">
                        <Grid>
                            <controls:SelectionIndicator ItemCount="2"
                                                         SelectedIndex="{TemplateBinding SelectedIndex}">
                                <Border Classes="SelectionPill"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        BoxShadow="{DynamicResource ControlShadow}" />
                            </controls:SelectionIndicator>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Grid>
                    </Border>
                    <Panel Grid.Row="1" ClipToBounds="True">
                        <ContentPresenter Name="PART_SelectedContentHost2"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsVisible="False" />
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.InspectorTab">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="InspectorTabSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.InspectorTab:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="TabItem.InspectorTab:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="TabItem.InspectorTab:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TabItem.InspectorTab:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Expander.InspectorExpander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <StackPanel>
                        <ToggleButton Name="InspectorExpanderHeader"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Padding="13,10"
                                      MinHeight="48"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CornerRadius="7"
                                      Cursor="Hand"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border Name="InspectorExpanderHeaderSurface"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalContentAlignment="Stretch"
                                                          VerticalContentAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" />
                                <Path Grid.Column="1"
                                      Name="InspectorExpanderChevron"
                                          Width="10"
                                          Height="10"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.35"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Stretch="Uniform"
                                          Data="M 1,3 L 5,7 L 9,3"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <Border Name="InspectorExpanderContent"
                                IsVisible="{TemplateBinding IsExpanded}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0" />
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander.InspectorExpander /template/ ToggleButton#InspectorExpanderHeader:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
    </Style>
    <Style Selector="Expander.InspectorExpander /template/ ToggleButton#InspectorExpanderHeader:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
    </Style>
    <Style Selector="Expander.InspectorExpander /template/ ToggleButton#InspectorExpanderHeader:focus-visible">
        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
    </Style>
    <Style Selector="Expander.InspectorExpander:disabled /template/ ToggleButton#InspectorExpanderHeader">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.InlinePicker">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MaxWidth" Value="210" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.InlinePicker:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.InlinePicker:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Track Name="PART_Track"
                           Margin="1,2"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Vertical"
                           IsDirectionReversed="True">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton"
                                          Opacity="0"
                                          Focusable="False" />
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Name="InspectorScrollThumb"
                                   Width="4"
                                   MinHeight="24"
                                   Background="{DynamicResource BorderStrongBrush}"
                                   Cursor="Hand"
                                   CornerRadius="2">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{TemplateBinding CornerRadius}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton"
                                          Opacity="0"
                                          Focusable="False" />
                        </Track.IncreaseButton>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb#InspectorScrollThumb">
        <Setter Property="Width" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style Selector="ProgressBar.TaskProgress">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Border Name="PART_Indicator"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.EngineSegment:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Animate painted surfaces and transforms without reflowing the desktop layout. -->
    <Style Selector="Button /template/ Border#ButtonSurface,
                     ComboBox /template/ Border#ComboFieldSurface,
                     ComboBoxItem /template/ Border,
                     RadioButton.EngineSegment /template/ Border,
                     TabItem.InspectorTab /template/ Border#InspectorTabSurface,
                     ToggleButton.ThemeSwitch /template/ Border#ThemeSwitchTrack,
                     ToggleSwitch.CompactSwitch /template/ Border#CompactSwitchTrack">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:not(.WindowAction) /template/ Border#ButtonSurface">
        <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24"
                                               Easing="0.22,1,0.36,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch /template/ Border#ThemeSwitchThumb">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
        <Setter Property="BoxShadow" Value="{DynamicResource ControlShadow}" />
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch /template/ Grid#CompactSwitchVisualKnob">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26"
                                               Easing="0.22,1,0.36,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Expander.InspectorExpander /template/ Path#InspectorExpanderChevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"
                                               Easing="0.22,1,0.36,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.TaskItem">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.TaskItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#ComboFieldSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToolTip /template/ Border">
        <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="ToggleButton.ThemeSwitch:checked /template/ Border#ThemeSwitchThumb">
        <Setter Property="RenderTransform" Value="translateX(28px)" />
    </Style>
    <Style Selector="ToggleSwitch.CompactSwitch:checked /template/ Grid#CompactSwitchVisualKnob">
        <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>
    <Style Selector="Expander.InspectorExpander:expanded /template/ Path#InspectorExpanderChevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="HyperlinkButton.TitleLink /template/ ContentPresenter > TextBlock">
        <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>

    <Style Selector="Grid#WorkbenchEntrance">
        <Style.Animations>
            <Animation Duration="0:0:0.36" Easing="0.22,1,0.36,1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ ScrollViewer#ComboPopupContent,
                     Expander.InspectorExpander:expanded /template/ Border#InspectorExpanderContent">
        <Style.Animations>
            <Animation Duration="0:0:0.24" Easing="0.22,1,0.36,1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="4" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ToolTip">
        <Style.Animations>
            <Animation Duration="0:0:0.16" Easing="0.22,1,0.36,1">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="HyperlinkButton.TitleLink,
                     Expander.InspectorExpander /template/ ToggleButton#InspectorExpanderHeader">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="0.25,0.1,0.25,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox /template/ Path#DropDownGlyph">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.22,1,0.36,1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Path#DropDownGlyph">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Button.PrimaryAction:pointerover /template/ Border#ButtonSurface,
                     Button.SecondaryAction:pointerover /template/ Border#ButtonSurface">
        <Setter Property="RenderTransform" Value="translateY(-1px) scale(1)" />
    </Style>
    <Style Selector="Button:not(.WindowAction):pressed /template/ Border#ButtonSurface">
        <Setter Property="RenderTransform" Value="translateY(0px) scale(0.98)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.09" Easing="0.25,0.1,0.25,1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.09" Easing="0.25,0.1,0.25,1" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="0.22,1,0.36,1" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
