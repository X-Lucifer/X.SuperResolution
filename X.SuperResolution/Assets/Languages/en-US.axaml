    <system:String x:Key="EmptyDescription">Choose local images, then fine-tune the recipe and output on the right</system:String>
    <system:String x:Key="SupportedFiles">PNG, JPG, JPEG, WEBP · Up to 50 MB each</system:String>
    <system:String x:Key="CurrentPlan">Current recipe</system:String>
    <system:String x:Key="AdvancedHint">GPU, tiles, concurrency and TTA</system:String>
