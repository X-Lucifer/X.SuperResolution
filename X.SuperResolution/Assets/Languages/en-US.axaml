    <system:String x:Key="ModelAndQuality">Everyday settings</system:String>
    <system:String x:Key="RuntimeAndOutput">Advanced performance</system:String>
    <system:String x:Key="TtaHint">Enhanced</system:String>
    <system:String x:Key="WorkspaceQueue">Canvas</system:String>
    <system:String x:Key="QueueHint">Select several images and process them in a stable queue</system:String>
    <system:String x:Key="RemoveTask">Remove task</system:String>
    <system:String x:Key="RunMonitor">This run</system:String>
    <system:String x:Key="BatchStatus">Run overview</system:String>
    <system:String x:Key="DeviceProfile">Device &amp; environment</system:String>
    <system:String x:Key="SystemInfo">System information</system:String>
    <system:String x:Key="ActivityLog">Activity log</system:String>
    <system:String x:Key="Minimize">Minimize</system:String>
    <system:String x:Key="Maximize">Maximize or restore</system:String>
    <system:String x:Key="PipelineReady">NCNN / Vulkan pipeline ready</system:String>
    <system:String x:Key="Language">Interface language</system:String>
    <system:String x:Key="ThemeToggleLabel">Switch between light and dark theme</system:String>
