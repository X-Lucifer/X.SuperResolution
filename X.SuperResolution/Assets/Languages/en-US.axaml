<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="EngineName">Engine</system:String>
    <system:String x:Key="GpuDevice">GPU device</system:String>
    <system:String x:Key="ModelPath">Model path</system:String>
    <system:String x:Key="NoiseLevel">Noise level</system:String>
    <system:String x:Key="TileSize">Tile size</system:String>
    <system:String x:Key="TTA_Mode">TTA mode</system:String>
    <system:String x:Key="OutputFormat">Output format</system:String>
    <system:String x:Key="OutputDirectory">Output directory</system:String>
    <system:String x:Key="Scale">Scale</system:String>
    <system:String x:Key="ThreadCount">Thread count</system:String>
    <system:String x:Key="ModelName">Model name</system:String>
    <system:String x:Key="Manufacturer">Manufacturer</system:String>
    <system:String x:Key="UserName">User name</system:String>
    <system:String x:Key="SerialNumber">Serial no.</system:String>
    <system:String x:Key="ProductName">Product name</system:String>
    <system:String x:Key="MemorySize">Memory size</system:String>
    <system:String x:Key="CpuCore">CPU cores</system:String>
    <system:String x:Key="Processor">Processor</system:String>
    <system:String x:Key="FileList">Task queue</system:String>
    <system:String x:Key="BatchStartTime">Start time</system:String>
    <system:String x:Key="BatchElapsed">Duration</system:String>
    <system:String x:Key="SubTaskElapsed">Elapsed</system:String>
    <system:String x:Key="StartTask">Start Tasks</system:String>
    <system:String x:Key="PauseTask">Pause Task</system:String>
    <system:String x:Key="ResumeTask">Resume Task</system:String>
    <system:String x:Key="StopTask">Stop Tasks</system:String>
    <system:String x:Key="ClearTask">Clear Tasks</system:String>
    <system:String x:Key="ClearLog">Clear Logs</system:String>
    <system:String x:Key="MainWindow">Main Window</system:String>
    <system:String x:Key="Exit">Exit</system:String>
    <system:String x:Key="MainTitle">AI Super Resolution</system:String>
    <system:String x:Key="OpenFile">Open Files</system:String>
    <system:String x:Key="FileSizeLimit">Up to 50 MB per file</system:String>
    <system:String x:Key="FileFormat">PNG · JPG · JPEG · WEBP</system:String>
    <system:String x:Key="ProductTagline">AI image enhancement workspace</system:String>
    <system:String x:Key="WorkspaceSettings">WORKSPACE SETTINGS</system:String>
    <system:String x:Key="ProcessingSettings">Processing setup</system:String>
    <system:String x:Key="ModelAndQuality">MODEL &amp; QUALITY</system:String>
    <system:String x:Key="RuntimeAndOutput">RUNTIME &amp; OUTPUT</system:String>
    <system:String x:Key="TtaHint">Enhanced</system:String>
    <system:String x:Key="WorkspaceQueue">WORKSPACE QUEUE</system:String>
    <system:String x:Key="QueueHint">Add images to create a processing queue</system:String>
    <system:String x:Key="RemoveTask">Remove task</system:String>
    <system:String x:Key="RunMonitor">RUN MONITOR</system:String>
    <system:String x:Key="BatchStatus">Batch status</system:String>
    <system:String x:Key="DeviceProfile">DEVICE PROFILE</system:String>
    <system:String x:Key="SystemInfo">System information</system:String>
    <system:String x:Key="ActivityLog">Activity log</system:String>
    <system:String x:Key="Minimize">Minimize</system:String>
    <system:String x:Key="Maximize">Maximize or restore</system:String>
    <system:String x:Key="PipelineReady">NCNN / Vulkan pipeline ready</system:String>
</ResourceDictionary>
