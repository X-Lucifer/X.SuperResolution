<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="EngineName">算法引擎</system:String>
    <system:String x:Key="GpuDevice">GPU 设备</system:String>
    <system:String x:Key="ModelPath">模型路径</system:String>
    <system:String x:Key="NoiseLevel">降噪级别</system:String>
    <system:String x:Key="TileSize">分块大小</system:String>
    <system:String x:Key="TTA_Mode">TTA 模式</system:String>
    <system:String x:Key="OutputFormat">输出格式</system:String>
    <system:String x:Key="OutputDirectory">输出目录</system:String>
    <system:String x:Key="Scale">放大倍率</system:String>
    <system:String x:Key="ThreadCount">线程数量</system:String>
    <system:String x:Key="ModelName">模型名称</system:String>
    <system:String x:Key="Manufacturer">制造商</system:String>
    <system:String x:Key="UserName">用户名称</system:String>
    <system:String x:Key="SerialNumber">主板序号</system:String>
    <system:String x:Key="ProductName">产品名称</system:String>
    <system:String x:Key="CpuCore">内核数量</system:String>
    <system:String x:Key="Processor">处理器</system:String>
    <system:String x:Key="MemorySize">内存容量</system:String>
    <system:String x:Key="FileList">任务队列</system:String>
    <system:String x:Key="BatchStartTime">开始时间</system:String>
    <system:String x:Key="BatchElapsed">任务耗时</system:String>
    <system:String x:Key="SubTaskElapsed">耗时</system:String>
    <system:String x:Key="StartTask">开始增强</system:String>
    <system:String x:Key="PauseTask">暂停任务</system:String>
    <system:String x:Key="ResumeTask">继续任务</system:String>
    <system:String x:Key="StopTask">停止任务</system:String>
    <system:String x:Key="ClearTask">清空任务</system:String>
    <system:String x:Key="ClearLog">清空日志</system:String>
    <system:String x:Key="MainWindow">主窗口</system:String>
    <system:String x:Key="Exit">退出</system:String>
    <system:String x:Key="MainTitle">AI 图像增强</system:String>
    <system:String x:Key="OpenFile">添加图片</system:String>
    <system:String x:Key="FileSizeLimit">单文件最大 50 MB</system:String>
    <system:String x:Key="FileFormat">PNG · JPG · JPEG · WEBP</system:String>
    <system:String x:Key="ProductTagline">AI 图像增强</system:String>
    <system:String x:Key="WorkspaceSettings">增强设置</system:String>
    <system:String x:Key="ProcessingSettings">选择增强方案</system:String>
    <system:String x:Key="ModelAndQuality">常用参数</system:String>
    <system:String x:Key="RuntimeAndOutput">高级性能设置</system:String>
    <system:String x:Key="TtaHint">增强</system:String>
    <system:String x:Key="WorkspaceQueue">创作区</system:String>
    <system:String x:Key="QueueHint">支持一次选择多张图片，按队列稳定处理</system:String>
    <system:String x:Key="RemoveTask">移除任务</system:String>
    <system:String x:Key="RunMonitor">本次运行</system:String>
    <system:String x:Key="BatchStatus">运行概览</system:String>
    <system:String x:Key="DeviceProfile">设备与环境</system:String>
    <system:String x:Key="SystemInfo">系统信息</system:String>
    <system:String x:Key="ActivityLog">处理日志</system:String>
    <system:String x:Key="Minimize">最小化</system:String>
    <system:String x:Key="Maximize">最大化或还原</system:String>
    <system:String x:Key="PipelineReady">NCNN / Vulkan 处理管线已就绪</system:String>
    <system:String x:Key="Language">界面语言</system:String>
    <system:String x:Key="EnhanceTab">增强设置</system:String>
    <system:String x:Key="ActivityTab">运行记录</system:String>
    <system:String x:Key="StudioTitle">让每一张图片都更清晰</system:String>
    <system:String x:Key="StudioDescription">批量放大、降噪并恢复自然细节</system:String>
    <system:String x:Key="EmptyTitle">从一张图片开始</system:String>
    <system:String x:Key="EmptyDescription">选择本地图片后，可在右侧调整增强方案与输出设置</system:String>
    <system:String x:Key="SupportedFiles">支持 PNG、JPG、JPEG、WEBP · 单张最大 50 MB</system:String>
    <system:String x:Key="CurrentPlan">当前方案</system:String>
    <system:String x:Key="AdvancedHint">GPU、分块、并行与 TTA</system:String>
    <system:String x:Key="SaveResults">保存结果</system:String>
    <system:String x:Key="RunDetailsHint">耗时、处理日志与设备信息</system:String>
    <system:String x:Key="DeviceDetails">查看设备详细信息</system:String>
    <system:String x:Key="ReadyHint">图片与方案确认后，即可开始增强</system:String>
    <system:String x:Key="RecipeHint">统一调整算法、画质与输出方式</system:String>
</ResourceDictionary>
