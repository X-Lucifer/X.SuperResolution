<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:X.SuperResolution.ViewModels"
             xmlns:views="using:X.SuperResolution.Views"
             x:Class="X.SuperResolution.Controls.ActivityPanel"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="3,0,3,0">
            <StackPanel Spacing="4">
                <TextBlock Classes="SectionTitle" Text="{DynamicResource ActivityTab}" />
                <TextBlock Text="{DynamicResource RunDetailsHint}"
                           Classes="Muted"
                           FontSize="10" />
            </StackPanel>
            <Border Grid.Column="1"
                    Width="34" Height="34"
                    CornerRadius="8"
                    Background="{DynamicResource AccentTintBrush}"
                    VerticalAlignment="Center">
                <Canvas Width="14" Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Data="M 2,11 L 11,2 M 6,2 L 11,2 L 11,7"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.5"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Classes="SettingsGroup"
                Padding="15"
                Background="{DynamicResource ElevatedSurfaceBrush}">
            <Grid RowDefinitions="Auto,13,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource BatchStatus}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <Border Grid.Column="1"
                            Padding="8,4"
                            CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="6" Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="VULKAN"
                                       Classes="Data"
                                       FontSize="8"
                                       Foreground="{DynamicResource PrimaryHoverBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{DynamicResource BatchElapsed}" Classes="FieldLabel" />
                        <TextBlock Text="{Binding BatchElapsedText}"
                                   Classes="Data"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="14,0" />
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BatchStartTime}" Classes="FieldLabel" />
                        <TextBlock Text="{Binding BatchStartTimeText}"
                                   Classes="Data Muted"
                                   FontSize="9"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="SettingsGroup" MinHeight="190">
            <Grid RowDefinitions="Auto,1,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="13,9,6,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="7" Height="7"
                                CornerRadius="4"
                                Background="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{DynamicResource ActivityLog}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="GhostAction"
                            Content="{DynamicResource ClearLog}"
                            MinHeight="28"
                            Padding="9,4"
                            FontSize="9"
                            Command="{Binding ClearLogCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                <TextBox Grid.Row="2"
                         x:Name="InfoTextBox"
                         Classes="LogViewer"
                         TextChanged="InfoTextBox_OnTextChanged"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         CornerRadius="0"
                         Padding="13,10"
                         FontFamily="{DynamicResource DataFontFamily}"
                         FontSize="9"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Background="{DynamicResource SurfaceBrush}" />
            </Grid>
        </Border>

        <Expander Grid.Row="3"
                  Classes="InspectorExpander"
                  IsExpanded="False"
                  AutomationProperties.Name="{DynamicResource DeviceDetails}">
            <Expander.Header>
                <StackPanel Spacing="2">
                    <TextBlock Text="{DynamicResource DeviceDetails}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource DeviceProfile}"
                               Classes="Muted"
                               FontSize="9" />
                </StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="150"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Manufacturer}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding SysInfo.ManufacturerName, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 TextTrimming="CharacterEllipsis"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource ProductName}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding SysInfo.ProductName, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 TextWrapping="Wrap"
                                                 ToolTip.Tip="{Binding SysInfo.ProductName, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource Processor}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding CpuInfo.Version, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding CpuInfo.Version, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource CpuCore}" VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding CpuCore, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 Classes="Data"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource MemorySize}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding MemorySize, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 Classes="Data"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource UserName}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding UserName, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                    <Border Classes="GroupDivider" />
                    <Border Classes="SettingRow">
                        <Grid ColumnDefinitions="98,*" ColumnSpacing="8">
                            <TextBlock Classes="FieldLabel" Text="{DynamicResource SerialNumber}"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding SysInfo.SerialNumber, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                 Classes="Data"
                                                 TextTrimming="CharacterEllipsis"
                                                 FontSize="9"
                                                 VerticalAlignment="Center"
                                                 x:CompileBindings="False" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>