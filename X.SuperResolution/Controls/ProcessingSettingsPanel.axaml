<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:X.SuperResolution.ViewModels"
             xmlns:model="using:X.SuperResolution.Model"
             xmlns:views="using:X.SuperResolution.Views"
             x:Class="X.SuperResolution.Controls.ProcessingSettingsPanel"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="3,0,3,14">
            <StackPanel Spacing="4">
                <TextBlock Classes="SectionTitle" Text="{DynamicResource ProcessingSettings}" />
                <TextBlock Classes="Muted"
                           FontSize="10"
                           Text="{DynamicResource RecipeHint}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="9,5"
                    CornerRadius="9"
                    Background="{DynamicResource PrimaryTintBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="NCNN · GPU"
                           Classes="Data"
                           FontSize="8"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHoverBrush}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="15" Margin="2,0,5,3">
                <StackPanel Spacing="7">
                    <TextBlock Classes="Eyebrow" Text="{DynamicResource EngineName}" Margin="2,0" />
                    <Border Classes="SettingsGroup"
                            Padding="4"
                            Background="{DynamicResource ElevatedSurfaceBrush}">
                        <UniformGrid Columns="3" Rows="1" ColumnSpacing="3">
                            <RadioButton Classes="EngineSegment"
                                         Content="Waifu2x"
                                         GroupName="EngineGroup"
                                         IsChecked="{Binding IsWaifu2x, Mode=TwoWay}"
                                         Command="{Binding ChangeEngineCommand}"
                                         CommandParameter="{x:Static model:EngineType.waifu2x}" />
                            <RadioButton Classes="EngineSegment"
                                         Content="Real-ESRGAN"
                                         GroupName="EngineGroup"
                                         IsChecked="{Binding IsRealESRGAN, Mode=TwoWay}"
                                         Command="{Binding ChangeEngineCommand}"
                                         CommandParameter="{x:Static model:EngineType.RealESRGAN}" />
                            <RadioButton Classes="EngineSegment"
                                         Content="SRMD"
                                         GroupName="EngineGroup"
                                         IsChecked="{Binding IsSrmd, Mode=TwoWay}"
                                         Command="{Binding ChangeEngineCommand}"
                                         CommandParameter="{x:Static model:EngineType.srmd}" />
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Classes="Eyebrow" Text="{DynamicResource ModelAndQuality}" Margin="2,0" />
                    <Border Classes="SettingsGroup">
                        <StackPanel>
                            <Border Classes="SettingRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource ModelPath}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Classes="InlineField"
                                              ItemsSource="{Binding CurrentEngineOption.model_paths}"
                                              AutomationProperties.Name="{DynamicResource ModelPath}"
                                              SelectedIndex="{Binding CurrentSelectedModelPathIndex}"
                                              DisplayMemberBinding="{Binding Value}"
                                              x:CompileBindings="False" />
                                </Grid>
                            </Border>

                            <StackPanel IsVisible="{Binding HasModelNameOption}">
                                <Border Classes="GroupDivider" />
                                <Border Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{DynamicResource ModelName}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  Classes="InlineField"
                                                  ItemsSource="{Binding CurrentEngineOption.model_names}"
                                                  AutomationProperties.Name="{DynamicResource ModelName}"
                                                  SelectedIndex="{Binding CurrentSelectedModelNameIndex}"
                                                  DisplayMemberBinding="{Binding Value}"
                                                  x:CompileBindings="False" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Classes="GroupDivider" />
                            <Border Classes="SettingRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource Scale}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Classes="InlineField"
                                              ItemsSource="{Binding CurrentEngineOption.scales}"
                                              AutomationProperties.Name="{DynamicResource Scale}"
                                              SelectedIndex="{Binding CurrentSelectedScaleIndex}"
                                              DisplayMemberBinding="{Binding Value}"
                                              x:CompileBindings="False" />
                                </Grid>
                            </Border>

                            <Border Classes="GroupDivider" />
                            <Border Classes="SettingRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource NoiseLevel}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Classes="InlineField"
                                              ItemsSource="{Binding CurrentEngineOption.noise_levels}"
                                              AutomationProperties.Name="{DynamicResource NoiseLevel}"
                                              SelectedIndex="{Binding CurrentSelectedNoiseLevelIndex}"
                                              DisplayMemberBinding="{Binding Value}"
                                              x:CompileBindings="False" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Classes="Eyebrow" Text="{DynamicResource SaveResults}" Margin="2,0" />
                    <Border Classes="SettingsGroup">
                        <StackPanel>
                            <Border Classes="SettingRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource OutputFormat}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Classes="InlineField"
                                              ItemsSource="{Binding CurrentEngineOption.output_formats}"
                                              AutomationProperties.Name="{DynamicResource OutputFormat}"
                                              SelectedIndex="{Binding CurrentSelectedOutputFormatIndex}"
                                              DisplayMemberBinding="{Binding Value}"
                                              x:CompileBindings="False" />
                                </Grid>
                            </Border>
                            <Border Classes="GroupDivider" />
                            <Border Classes="SettingRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{DynamicResource OutputDirectory}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="InlinePicker"
                                            Command="{Binding SelectOutputDirectoryCommand}"
                                            AutomationProperties.Name="{DynamicResource OutputDirectory}"
                                            ToolTip.Tip="{Binding OutputDirectory}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                            <TextBlock Text="{Binding OutputDirectory}"
                                                       Classes="Data"
                                                       FontSize="9"
                                                       TextTrimming="PrefixCharacterEllipsis"
                                                       MaxWidth="165"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="↗"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryHoverBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Expander Classes="InspectorExpander"
                          IsExpanded="False"
                          AutomationProperties.Name="{DynamicResource RuntimeAndOutput}">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{DynamicResource RuntimeAndOutput}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource AdvancedHint}"
                                       Classes="Muted"
                                       FontSize="9" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Border Classes="SettingRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{DynamicResource GpuDevice}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Classes="InlineField"
                                          ItemsSource="{Binding GpuList, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                          AutomationProperties.Name="{DynamicResource GpuDevice}"
                                          SelectedValue="{Binding SelectedGpuIndex}"
                                          DisplayMemberBinding="{Binding Value}"
                                          SelectedValueBinding="{Binding Key}"
                                          x:CompileBindings="False" />
                            </Grid>
                        </Border>
                        <Border Classes="GroupDivider" />
                        <Border Classes="SettingRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{DynamicResource TileSize}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Classes="InlineField"
                                          ItemsSource="{Binding CurrentEngineOption.tile_sizes}"
                                          AutomationProperties.Name="{DynamicResource TileSize}"
                                          SelectedIndex="{Binding CurrentSelectedTileSizeIndex}"
                                          DisplayMemberBinding="{Binding Value}"
                                          x:CompileBindings="False" />
                            </Grid>
                        </Border>
                        <Border Classes="GroupDivider" />
                        <Border Classes="SettingRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{DynamicResource ThreadCount}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Classes="InlineField"
                                          ItemsSource="{Binding CurrentEngineOption.thread_counts}"
                                          AutomationProperties.Name="{DynamicResource ThreadCount}"
                                          SelectedIndex="{Binding CurrentSelectedThreadCountIndex}"
                                          DisplayMemberBinding="{Binding Value}"
                                          x:CompileBindings="False" />
                            </Grid>
                        </Border>
                        <Border Classes="GroupDivider" />
                        <Border Classes="SettingRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource TTA_Mode}" FontSize="11" />
                                    <TextBlock Text="{DynamicResource TtaHint}"
                                               Classes="Tertiary"
                                               FontSize="9" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Classes="CompactSwitch"
                                              AutomationProperties.Name="{DynamicResource TTA_Mode}"
                                              OnContent=""
                                              OffContent=""
                                              IsChecked="{Binding TtaMode}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
