<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:X.SuperResolution.ViewModels"
             xmlns:model="using:X.SuperResolution.Model"
             x:Class="X.SuperResolution.Controls.TaskWorkspace"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="Card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0"
                    Padding="24,20"
                    Background="{DynamicResource HeroGradientBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Classes="Eyebrow"
                                       Text="{DynamicResource WorkspaceQueue}"
                                       VerticalAlignment="Center" />
                            <Border Padding="8,3"
                                    CornerRadius="9"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding TaskList.Count}"
                                               Classes="Data"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHoverBrush}" />
                                    <TextBlock Text="IMG"
                                               Classes="Data Tertiary"
                                               FontSize="8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="PageTitle" Text="{DynamicResource StudioTitle}" />
                        <TextBlock Classes="Muted"
                                   FontSize="12"
                                   Text="{DynamicResource StudioDescription}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="PrimaryAction HeaderAction"
                            Command="{Binding SelectFileCommand}"
                            AutomationProperties.Name="{DynamicResource OpenFile}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="＋"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource OpenFile}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="13"
                            IsVisible="{Binding IsQueueEmpty}">
                    <Grid Width="126" Height="100" IsHitTestVisible="False">
                        <Border Width="70" Height="70"
                                Margin="0,0,38,18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                CornerRadius="18"
                                Background="{DynamicResource PeachTintBrush}"
                                BorderBrush="#43F19CA6"
                                BorderThickness="1" />
                        <Border Width="76" Height="76"
                                Margin="25,0,0,14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                CornerRadius="20"
                                Background="{DynamicResource AccentTintBrush}"
                                BorderBrush="#4073A7E8"
                                BorderThickness="1" />
                        <Border Width="74" Height="74"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                CornerRadius="20"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Path Data="M 20,47 L 33,34 L 42,43 L 49,36 L 56,47"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round" />
                                <Ellipse Width="7" Height="7"
                                         Margin="0,0,24,26"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Fill="{DynamicResource PeachBrush}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource EmptyTitle}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource EmptyDescription}"
                                   Classes="Muted"
                                   FontSize="12"
                                   MaxWidth="430"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Classes="PrimaryAction"
                            MinWidth="142"
                            Command="{Binding SelectFileCommand}"
                            AutomationProperties.Name="{DynamicResource OpenFile}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="＋" FontSize="16" />
                            <TextBlock Text="{DynamicResource OpenFile}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{DynamicResource SupportedFiles}"
                               Classes="Tertiary"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Margin="18,16"
                              IsVisible="{Binding HasTasks}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding TaskList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:TaskItem">
                                <Border Classes="TaskItem" Padding="14,12" Margin="0,0,0,9">
                                    <Grid ColumnDefinitions="48,*,102,36" ColumnSpacing="13">
                                        <Border Width="46" Height="46"
                                                CornerRadius="13"
                                                Background="{DynamicResource HeroGradientBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="IMG"
                                                       Classes="Data"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryHoverBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <TextBlock Text="{Binding Path}"
                                                       Classes="Tertiary Data"
                                                       FontSize="9"
                                                       TextTrimming="PrefixCharacterEllipsis"
                                                       ToolTip.Tip="{Binding Path}" />
                                            <ProgressBar Classes="TaskProgress"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Progress}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Spacing="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="3">
                                                <TextBlock Text="{Binding Progress}"
                                                           Classes="Data"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryHoverBrush}" />
                                                <TextBlock Text="%"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ElapsedText}"
                                                       Classes="Data Tertiary"
                                                       FontSize="8"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Classes="IconAction"
                                                Content="×"
                                                FontSize="16"
                                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveTaskCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{DynamicResource RemoveTask}"
                                                ToolTip.Tip="{DynamicResource RemoveTask}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18,13"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ReadyHint}"
                                   FontSize="11"
                                   FontWeight="Medium" />
                        <TextBlock Text="{DynamicResource SupportedFiles}"
                                   Classes="Tertiary"
                                   FontSize="9" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="GhostAction ActionButton"
                                MinWidth="86"
                                Content="{DynamicResource ClearTask}"
                                Command="{Binding ClearTaskCommand}" />
                        <Button Classes="DangerAction ActionButton"
                                MinWidth="86"
                                Content="{DynamicResource StopTask}"
                                Command="{Binding CancelTaskCommand}" />
                        <Button Classes="PrimaryAction ActionButton"
                                MinWidth="132"
                                AutomationProperties.Name="{DynamicResource StartTask}"
                                Command="{Binding StartTaskCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✦" />
                                <TextBlock Text="{DynamicResource StartTask}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
