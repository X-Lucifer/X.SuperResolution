<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xss="clr-namespace:X.SuperResolution"
             x:Class="X.SuperResolution.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <xss:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Languages/zh-CN.axaml" />
                <ResourceInclude Source="Assets/Themes/WorkbenchColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://X.SuperResolution/Assets/Themes/WorkbenchStyles.axaml" />
    </Application.Styles>
</Application>
