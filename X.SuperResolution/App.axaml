<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xss="clr-namespace:X.SuperResolution"
             x:Class="X.SuperResolution.App"
             RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <xss:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Languages/zh-CN.axaml" />
                <ResourceInclude Source="Assets/Themes/WorkbenchColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#34765A"
                                       RegionColor="#FFFFFF"
                                       ErrorText="#AB525A" />
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#73B892"
                                       RegionColor="#292929"
                                       ErrorText="#E8A2AB" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://X.SuperResolution/Assets/Themes/WorkbenchStyles.axaml" />
    </Application.Styles>
</Application>
